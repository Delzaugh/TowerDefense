      "fps": 24
    },
    {
      "name": "move",
      "meaning": "Unhurried 1.5-second in-place walk with heel-to-toe contacts, supported weight transfer, overlapping arm swing and a stable head. Runtime supplies forward travel; stance-matching speed is approximately 0.409 metres per second at 1x playback.",
      "playback": "loop",
      "fps": 24
    }
